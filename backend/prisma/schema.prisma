// Prisma Schema para Sistema de Inventario y Catálogo Web de Bisutería
// Configurado para PostgreSQL (Supabase en la nube y producción)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Articulo {
  id                 String   @id @default(uuid())
  sku                String   @unique
  nombre             String
  categoria          String
  descripcion        String   @default("")

  costoBase          Float
  utilidad           Float
  pvp                Float
  overridePrecio     Boolean  @default(false)
  precioManual       Float?

  stock              Int      @default(0)
  imagenUrl          String   @default("")
  imagenPublicId     String?
  estado             String   @default("Disponible")

  fechaActualizacion DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("articulos")
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  password  String
  rol       String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model Configuracion {
  id                      String   @id @default(uuid())
  whatsappPhone           String   @default("584120000000")
  mensajePlantilla        String   @default("¡Hola! Me interesa este producto: {nombre} - SKU: {sku} - Precio: ${pvp}")
  nombreTienda            String   @default("CHESKY Bisutería & Accesorios")
  instagram               String   @default("@chesky.joyas")
  monedaSecundariaActiva  Boolean  @default(false)
  monedaSecundariaSimbolo String   @default("Bs.")
  tasaCambio              Float    @default(0)
  notificarBajoStock      Boolean  @default(true)
  umbralBajoStock         Int      @default(3)
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())

  @@map("configuraciones")
}
