# Puerto del servidor backend
PORT=5000
NODE_ENV=development

# Base de datos (sqlite para local, postgresql para producción en Supabase)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./chesky.db"

# Seguridad y Autenticación JWT
JWT_SECRET="chesky_jewelry_jwt_secret_change_me_in_production_key_2026"
JWT_EXPIRES_IN="7d"

# Almacenamiento de Fotos en la Nube (Supabase Storage - 100% Funciona en Venezuela)
# Si se dejan vacíos, se guardan en la carpeta local /uploads/
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="chesky-productos"

# Configuración de Ventas y Negocio
# Número telefónico de WhatsApp con código de país (ejemplo: 584121234567)
WHATSAPP_PHONE_NUMBER="584120000000"

# Origen permitido para CORS (Frontend)
CORS_ORIGIN="http://localhost:5173"
